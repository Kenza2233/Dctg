# Telegram Bot Token - Get from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Discord Bot Token - Get from Discord Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Discord Text Channel ID - Channel to send images
DISCORD_CHANNEL_ID=your_discord_text_channel_id_here
# Discord Voice Channel ID - Voice channel to stay 24/7
DISCORD_VOICE_CHANNEL_ID=your_discord_voice_channel_id_here
# Telegram Allowed Chat IDs
# Set "all" to accept from all chats
# Or enter comma-separated IDs: 123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=all
# Port (optional)
PORT=3000
